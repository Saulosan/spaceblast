826C  18                00997     CLC
826D  7D3905            00998     ADC FAMISTUDIO_PITCH_ENV_VALUE_LO,X
8270  9D3905            00999     STA FAMISTUDIO_PITCH_ENV_VALUE_LO,X
8273  A503              01000     LDA .TEMP_PITCH
8275  2980              01001     AND #$80
8277  1002              01002     BPL .PITCH_RELATIVE_POS  
8279  A9FF              01003     LDA #$FF
