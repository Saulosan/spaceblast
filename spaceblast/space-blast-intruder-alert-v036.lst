B3D4  A000              20688 	LDY #0
B3D6  A205              20689 	LDX #5
B3D8  8602              20690 	STX TEMP
B3DA  A200              20691 	LDX #0
B3DC  8603              20692 	STX TEMP+1
B3DE  2002C2            20693 	JSR _DIV16
B3E1  2903              20694 	AND #3
