867B                    01839 
867B                    01840     ; If you hit this, this mean you either:
867B                    01841     ; - exported a song that uses FamiStudio tempo but have defined "FAMISTUDIO_USE_FAMITRACKER_TEMPO"
867B                    01842     ; - use delayed notes/cuts, but didnt enable "FAMISTUDIO_USE_FAMITRACKER_DELAYED_NOTES_OR_CUTS"
867B                    01843     ; - use vibrato effect, but didnt enable "FAMISTUDIO_USE_VIBRATO"
867B                    01844     ; - use arpeggiated chords, but didnt enable "FAMISTUDIO_USE_ARPEGGIO"
867B                    01845     ; - use fine pitches, but didnt enable "FAMISTUDIO_USE_PITCH_TRACK"
867B                    01846     ; - use a duty cycle effect, but didnt enable "FAMISTUDIO_USE_DUTYCYCLE_EFFECT"
867B                    01847     ; - use slide notes, but didnt enable "FAMISTUDIO_USE_SLIDE_NOTES"
867B                    01848     ; - use volume slides, but didnt enable "FAMISTUDIO_USE_VOLUME_SLIDES"
867B                    01849     ; - use DMC counter effect, but didnt enable "FAMISTUDIO_USE_DELTA_COUNTER"
867B                    01850     ; - use a Phase Reset efect, but didnt enable the "FAMISTUDIO_USE_PHASE_RESET"
867B                    01851     ; - use an instrument > 63, but didnt enable "FAMISTUDIO_USE_INSTRUMENT_EXTENDED_RANGE"
867B                    01852 
