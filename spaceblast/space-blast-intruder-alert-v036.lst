8135                    00701 ;======================================================================================================================
8135                    00702 ; FAMISTUDIO_MUSIC_PAUSE (public)
8135                    00703 ;
8135                    00704 ; Pause/unpause the currently playing song. Note that this will not update the APU, so sound might linger. Calling
8135                    00705 ; famistudio_update after this will update the APU.
8135                    00706 ; 
8135                    00707 ; [in] a : zero to play, non-zero to pause.
8135                    00708 ;======================================================================================================================
8135                    00709 
8135                    00710 FAMISTUDIO_MUSIC_PAUSE:
8135                    00711 
8135  AA                00712     TAX
8136  F018              00713     BEQ .UNPAUSE
8138                    00714     
8138                    00715 .PAUSE:
8138                    00716 
8138  20A686            00717     JSR FAMISTUDIO_SAMPLE_STOP
813B                    00718     
813B  A900              00719     LDA #0
813D  8D0205            00720     STA FAMISTUDIO_ENV_VALUE+FAMISTUDIO_CH0_ENVS+FAMISTUDIO_ENV_VOLUME_OFF
8140  8D0505            00721     STA FAMISTUDIO_ENV_VALUE+FAMISTUDIO_CH1_ENVS+FAMISTUDIO_ENV_VOLUME_OFF
8143  8D0805            00722     STA FAMISTUDIO_ENV_VALUE+FAMISTUDIO_CH2_ENVS+FAMISTUDIO_ENV_VOLUME_OFF
8146  8D0A05            00723     STA FAMISTUDIO_ENV_VALUE+FAMISTUDIO_CH3_ENVS+FAMISTUDIO_ENV_VOLUME_OFF
8149  AD9405            00724     LDA FAMISTUDIO_SONG_SPEED ; <= 0 pauses the music
814C  0980              00725     ORA #$80
814E  D005              00726     BNE .DONE
8150                    00727 .UNPAUSE:
8150  AD9405            00728     LDA FAMISTUDIO_SONG_SPEED ; > 0 unpause music
8153  297F              00729     AND #$7F
8155                    00730 .DONE:
8155  8D9405            00731     STA FAMISTUDIO_SONG_SPEED
8158                    00732 
8158  60                00733     RTS
8159                    00734 
8159                    00735 ;======================================================================================================================
8159                    00736 ; FAMISTUDIO_GET_NOTE_PITCH_MACRO (internal)
8159                    00737 ;
8159                    00738 ; Uber-macro used to compute the final pitch of a note, taking into account the current note, arpeggios, instrument
8159                    00739 ; pitch envelopes, slide notes and fine pitch tracks.
8159                    00740 ; 
8159                    00741 ; [in] x : note index.
8159                    00742 ; [in] y : slide/pitch envelope index.
8159                    00743 ; [out] famistudio_ptr1 : Final note pitch.
8159                    00744 ;======================================================================================================================
8159                    00745 
8159                    00746 
8159                    00747 FAMISTUDIO_GET_NOTE_PITCH:
8159                    00748 
8159                    00749 ;note_table_lsb_M0001 = famistudio_note_table_lsb ; Getting "Internal error" when trying to do this.
8159                    00750 ;note_table_msb_M0001 = famistudio_note_table_msb ; Getting "Internal error" when trying to do this.
8159                    00751 
8159                    00752 
8159                    00753 
8159                    00754     ; Pitch envelope + fine pitch (sign extended)
8159  18                00755     CLC
815A  B94B05            00756     LDA FAMISTUDIO_PITCH_ENV_FINE_VALUE+0, Y 
815D  793905            00757     ADC FAMISTUDIO_PITCH_ENV_VALUE_LO+0, Y 
8160  8508              00758     STA FAMISTUDIO_PTR1+0
8162  B94B05            00759     LDA FAMISTUDIO_PITCH_ENV_FINE_VALUE+0, Y 
8165  2980              00760     AND #$80
8167  F002              00761     BEQ .POS
8169  A9FF              00762     LDA #$FF
816B                    00763 .POS:
816B  793C05            00764     ADC FAMISTUDIO_PITCH_ENV_VALUE_HI+0, Y 
816E  8509              00765     STA FAMISTUDIO_PTR1+1
8170                    00766 
8170                    00767 
8170                    00768     ; Check if there is an active slide.
8170  B94E05            00769     LDA FAMISTUDIO_SLIDE_STEP+0, Y 
8173  F017              00770     BEQ .NO_SLIDE
8175                    00771 
8175                    00772     ; Add slide
8175                    00773     ; Most channels have 1 bit of fraction for slides.
8175  B95405            00774     LDA FAMISTUDIO_SLIDE_PITCH_HI+0, Y 
8178  C980              00775     CMP #$80 ; Sign extend upcoming right shift.
817A  6A                00776     ROR A ; We have 1 bit of fraction for slides, shift right hi byte.
817B  8502              00777     STA FAMISTUDIO_R0
817D  B95105            00778     LDA FAMISTUDIO_SLIDE_PITCH_LO+0, Y 
8180  6A                00779     ROR A ; Shift right low byte.
8181  18                00780     CLC
8182  6508              00781     ADC FAMISTUDIO_PTR1+0
8184  8508              00782     STA FAMISTUDIO_PTR1+0
8186  A502              00783     LDA FAMISTUDIO_R0
8188  6509              00784     ADC FAMISTUDIO_PTR1+1 
818A  8509              00785     STA FAMISTUDIO_PTR1+1 
818C                    00786 
818C                    00787 .NO_SLIDE:    
818C                    00788 
818C                    00789 
818C                    00790     ; Finally, add note pitch.
818C  18                00791     CLC
818D  BDB586            00792     LDA FAMISTUDIO_NOTE_TABLE_LSB,X ; famistudio_note_table_lsb = note_table_lsb
8190  6508              00793     ADC FAMISTUDIO_PTR1+0
8192  8508              00794     STA FAMISTUDIO_PTR1+0
8194  BD1687            00795     LDA FAMISTUDIO_NOTE_TABLE_MSB,X ; famistudio_note_table_msb = note_table_msb
8197  6509              00796     ADC FAMISTUDIO_PTR1+1
8199  8509              00797     STA FAMISTUDIO_PTR1+1   
819B                    00798 
819B  60                00799     RTS
819C                    00800 
819C                    00801 
