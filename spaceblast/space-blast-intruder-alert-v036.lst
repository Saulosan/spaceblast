8000                    00464 ;======================================================================================================================
8000                    00465 ; FAMISTUDIO_INIT (public)
8000                    00466 ;
8000                    00467 ; Reset APU, initialize the sound engine with some music data.
8000                    00468 ; 
8000                    00469 ; [in] a : Playback platform, zero for PAL, non-zero for NTSC.
8000                    00470 ; [in] x : Pointer to music data (lo)
8000                    00471 ; [in] y : Pointer to music data (hi)
8000                    00472 ;======================================================================================================================
8000                    00473 
8000                    00474 FAMISTUDIO_INIT:
8000                    00475     
8000                    00476 .MUSIC_DATA_PTR: EQU FAMISTUDIO_PTR0
8000                    00477 
8000  8E8B05            00478     STX FAMISTUDIO_SONG_LIST_LO
8003  8C8C05            00479     STY FAMISTUDIO_SONG_LIST_HI
8006  8606              00480     STX .MUSIC_DATA_PTR+0
8008  8407              00481     STY .MUSIC_DATA_PTR+1
800A                    00482 
800A  A961              00483         LDA #97
800C  8D8A05            00484     STA FAMISTUDIO_PAL_ADJUST
800F                    00485 
800F  205880            00486     JSR FAMISTUDIO_MUSIC_STOP
8012                    00487 
8012                    00488     ; Instrument address
8012  A001              00489     LDY #1
8014  B106              00490     LDA (.MUSIC_DATA_PTR),Y
8016  8D8D05            00491     STA FAMISTUDIO_INSTRUMENT_LO
8019  C8                00492     INY
801A  B106              00493     LDA (.MUSIC_DATA_PTR),Y
801C  8D8E05            00494     STA FAMISTUDIO_INSTRUMENT_HI
801F  C8                00495     INY
8020                    00496 
8020                    00497     ; Expansions instrument address
8020                    00498 
8020                    00499     ; Sample list address
8020  B106              00500     LDA (.MUSIC_DATA_PTR),Y
8022  8D8F05            00501     STA FAMISTUDIO_DPCM_LIST_LO
8025  C8                00502     INY
8026  B106              00503     LDA (.MUSIC_DATA_PTR),Y
8028  8D9005            00504     STA FAMISTUDIO_DPCM_LIST_HI
802B                    00505 
802B  A980              00506     LDA #$80 ; Previous pulse period MSB, to not write it when not changed
802D  8D9205            00507     STA FAMISTUDIO_PULSE1_PREV
8030  8D9305            00508     STA FAMISTUDIO_PULSE2_PREV
8033                    00509 
8033  A90F              00510     LDA #$0F ; Enable channels, stop DMC
8035  8D1540            00511     STA FAMISTUDIO_APU_SND_CHN
8038  A980              00512     LDA #$80 ; Disable triangle length counter
803A  8D0840            00513     STA FAMISTUDIO_APU_TRI_LINEAR
803D  A900              00514     LDA #$00 ; Load noise length
803F  8D0F40            00515     STA FAMISTUDIO_APU_NOISE_HI
8042                    00516 
8042  A930              00517     LDA #$30 ; Volumes to 0
8044  8D0040            00518     STA FAMISTUDIO_APU_PL1_VOL
8047  8D0440            00519     STA FAMISTUDIO_APU_PL2_VOL
804A  8D0C40            00520     STA FAMISTUDIO_APU_NOISE_VOL
804D  A908              00521     LDA #$08 ; No sweep
804F  8D0140            00522     STA FAMISTUDIO_APU_PL1_SWEEP
8052  8D0540            00523     STA FAMISTUDIO_APU_PL2_SWEEP
8055                    00524 
8055                    00525 
8055                    00526 
8055                    00527 .INIT_EPSM:
8055                    00528 
8055                    00529 
8055  4C5880            00530     JMP FAMISTUDIO_MUSIC_STOP
8058                    00531 
8058                    00532 ;======================================================================================================================
8058                    00533 ; FAMISTUDIO_MUSIC_STOP (public)
8058                    00534 ;
8058                    00535 ; Stops any music currently playing, if any. Note that this will not update the APU, so sound might linger. Calling
8058                    00536 ; famistudio_update after this will update the APU.
8058                    00537 ; 
8058                    00538 ; [in] no input params.
8058                    00539 ;======================================================================================================================
8058                    00540 
8058                    00541 FAMISTUDIO_MUSIC_STOP:
8058                    00542 
8058  A900              00543     LDA #0
805A  8D9405            00544     STA FAMISTUDIO_SONG_SPEED
805D  8D9105            00545     STA FAMISTUDIO_DPCM_EFFECT
8060                    00546 
8060  A200              00547     LDX #0
8062                    00548 
8062                    00549 .SET_CHANNELS:
8062                    00550 
8062  9D6605            00551     STA FAMISTUDIO_CHN_REPEAT,X
8065  9D6105            00552     STA FAMISTUDIO_CHN_NOTE,X
8068  9D7505            00553     STA FAMISTUDIO_CHN_REF_LEN,X
806B  9D7A05            00554         STA FAMISTUDIO_CHN_VOLUME_TRACK,X
806E  9D7F05            00555         STA FAMISTUDIO_CHN_ENV_OVERRIDE,X
8071  E8                00556     INX
8072  E005              00557     CPX #FAMISTUDIO_NUM_CHANNELS
8074  D0EC              00558     BNE .SET_CHANNELS
8076                    00559 
8076                    00560 
8076  A200              00561     LDX #0
8078                    00562 .SET_SLIDES:
8078                    00563 
8078  9D4E05            00564     STA FAMISTUDIO_SLIDE_STEP, X
807B  E8                00565     INX
807C  E003              00566     CPX #FAMISTUDIO_NUM_SLIDES
807E  D0F8              00567     BNE .SET_SLIDES
8080                    00568 
8080                    00569 
8080  A200              00570     LDX #0
8082                    00571 
8082                    00572 .SET_ENVELOPES:
8082                    00573 
8082  A9AC              00574     LDA #(FAMISTUDIO_DUMMY_ENVELOPE & $FF)
8084  9D1805            00575     STA FAMISTUDIO_ENV_ADDR_LO,X
8087  A986              00576     LDA #(FAMISTUDIO_DUMMY_ENVELOPE >> 8)
8089  9D2305            00577     STA FAMISTUDIO_ENV_ADDR_HI,X
808C  A900              00578     LDA #0
808E  9D0D05            00579     STA FAMISTUDIO_ENV_REPEAT,X
8091  9D0205            00580     STA FAMISTUDIO_ENV_VALUE,X
8094  9D2E05            00581     STA FAMISTUDIO_ENV_PTR,X
8097  E8                00582     INX
8098  E00B              00583     CPX #FAMISTUDIO_NUM_ENVELOPES
809A  D0E6              00584     BNE .SET_ENVELOPES
809C                    00585 
809C  A200              00586     LDX #0
809E                    00587 .SET_PITCH_ENVELOPES:
809E                    00588 
809E  A9B0              00589     LDA #(FAMISTUDIO_DUMMY_PITCH_ENVELOPE & $FF)
80A0  9D4205            00590     STA FAMISTUDIO_PITCH_ENV_ADDR_LO,X
80A3  A986              00591     LDA #(FAMISTUDIO_DUMMY_PITCH_ENVELOPE >> 8)
80A5  9D4505            00592     STA FAMISTUDIO_PITCH_ENV_ADDR_HI,X
80A8  A900              00593     LDA #0
80AA  9D3F05            00594     STA FAMISTUDIO_PITCH_ENV_REPEAT,X
80AD  9D3905            00595     STA FAMISTUDIO_PITCH_ENV_VALUE_LO,X
80B0  9D3C05            00596     STA FAMISTUDIO_PITCH_ENV_VALUE_HI,X
80B3  9D4B05            00597         STA FAMISTUDIO_PITCH_ENV_FINE_VALUE,X
80B6  A901              00598     LDA #1
80B8  9D4805            00599     STA FAMISTUDIO_PITCH_ENV_PTR,X
80BB  E8                00600     INX
80BC  E003              00601     CPX #FAMISTUDIO_NUM_PITCH_ENVELOPES
80BE  D0DE              00602     BNE .SET_PITCH_ENVELOPES
80C0                    00603 
80C0  4CA686            00604     JMP FAMISTUDIO_SAMPLE_STOP
80C3                    00605 
80C3                    00606 ;======================================================================================================================
80C3                    00607 ; FAMISTUDIO_MUSIC_PLAY (public)
80C3                    00608 ;
80C3                    00609 ; Plays a song from the loaded music data (from a previous call to famistudio_init).
80C3                    00610 ; 
80C3                    00611 ; [in] a : Song index.
80C3                    00612 ;======================================================================================================================
80C3                    00613 
80C3                    00614 FAMISTUDIO_MUSIC_PLAY:
80C3                    00615 
80C3                    00616 .TMP: EQU FAMISTUDIO_R0
80C3                    00617 .SONG_LIST_PTR: EQU FAMISTUDIO_PTR0
80C3                    00618 .TEMP_ENV_PTR: EQU FAMISTUDIO_PTR1
80C3                    00619 
80C3  AE8B05            00620     LDX FAMISTUDIO_SONG_LIST_LO
80C6  8606              00621     STX .SONG_LIST_PTR+0
80C8  AE8C05            00622     LDX FAMISTUDIO_SONG_LIST_HI
80CB  8607              00623     STX .SONG_LIST_PTR+1
80CD                    00624 
80CD  A000              00625     LDY #0
80CF  D106              00626     CMP (.SONG_LIST_PTR),Y
80D1  9001              00627     BCC .VALID_SONG
80D3  60                00628     RTS ; Invalid song index.
80D4                    00629 
80D4                    00630 .VALID_SONG:
80D4                    00631     ; Here we basically assume we have 17 songs or less (17 songs * 14 bytes per song + 5 bytes header < 256).
80D4  0A                00632     ASL A
80D5  8502              00633     STA .TMP
80D7  0A                00634     ASL A
80D8  AA                00635     TAX
80D9  0A                00636     ASL A
80DA  6502              00637     ADC .TMP
80DC  8602              00638     STX .TMP
80DE  6502              00639     ADC .TMP
80E0  6905              00640     ADC #5 ; Song count + instrument ptr + sample ptr
80E2  A8                00641     TAY
80E3                    00642 
80E3  205880            00643     JSR FAMISTUDIO_MUSIC_STOP
80E6                    00644 
80E6  A200              00645     LDX #0
80E8                    00646 
80E8                    00647 .SET_CHANNELS:
80E8                    00648 
80E8                    00649     ; Channel data address
80E8  B106              00650     LDA (.SONG_LIST_PTR),Y
80EA  9D5705            00651     STA FAMISTUDIO_CHN_PTR_LO,X
80ED  C8                00652     INY
80EE  B106              00653     LDA (.SONG_LIST_PTR),Y
80F0  9D5C05            00654     STA FAMISTUDIO_CHN_PTR_HI,X
80F3  C8                00655     INY
80F4                    00656 
80F4  A900              00657     LDA #0
80F6  9D6605            00658     STA FAMISTUDIO_CHN_REPEAT,X
80F9  9D6105            00659     STA FAMISTUDIO_CHN_NOTE,X
80FC  9D7505            00660     STA FAMISTUDIO_CHN_REF_LEN,X
80FF  A9F0              00661         LDA #$F0
8101  9D7A05            00662         STA FAMISTUDIO_CHN_VOLUME_TRACK,X
8104                    00663 
8104                    00664 .NEXTCHANNEL:
8104  E8                00665     INX
8105  E005              00666     CPX #FAMISTUDIO_NUM_CHANNELS
8107  D0DF              00667     BNE .SET_CHANNELS
8109                    00668 
8109  B106              00669     LDA (.SONG_LIST_PTR),Y
810B  8D8405            00670     STA FAMISTUDIO_TEMPO_ENV_PTR_LO
810E  8508              00671     STA .TEMP_ENV_PTR+0
8110  C8                00672     INY
8111  B106              00673     LDA (.SONG_LIST_PTR),Y
8113  8D8505            00674     STA FAMISTUDIO_TEMPO_ENV_PTR_HI
8116  8509              00675     STA .TEMP_ENV_PTR+1
8118  C8                00676     INY
8119  B106              00677     LDA (.SONG_LIST_PTR),Y
811B  AA                00678     TAX
811C  BD8A87            00679     LDA FAMISTUDIO_TEMPO_FRAME_LOOKUP, X ; Lookup contains the number of frames to run (0,1,2) to maintain tempo
811F  8D8805            00680     STA FAMISTUDIO_TEMPO_FRAME_NUM
8122  A000              00681     LDY #0
8124  8C8705            00682     STY FAMISTUDIO_TEMPO_ENV_IDX
8127  B108              00683     LDA (.TEMP_ENV_PTR),Y
8129  18                00684     CLC 
812A  6901              00685     ADC #1
812C  8D8605            00686     STA FAMISTUDIO_TEMPO_ENV_COUNTER
812F  A906              00687     LDA #6
8131  8D9405            00688     STA FAMISTUDIO_SONG_SPEED ; Non-zero simply so the song isnt considered paused.
8134                    00689 
8134                    00690 
8134                    00691 
8134                    00692 
8134                    00693 
