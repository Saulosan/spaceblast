CA46                    02031 	; 
CA46                    02032 	; 	'
CA46                    02033 	; 	' SPACE BLAST - port NES (CVBasic) da demo HTML5 de Saulo San
CA46                    02034 	; 	' Baseado nos assets/logica originais (saulosan.com.br/caravanblast)
CA46                    02035 	; 	'
CA46                    02036 	; 	' v0.13 (feedback do Saulo): (a) o boss.png era um SPRITESHEET de 2
CA46                    02037 	; 	'   frames (96x64 cada), NAO 2 naves gemeas! Boss = UMA nave 96x64
CA46                    02038 	; 	'   NO ALTO, 100% Background: ceu todo preto + tiles na tabela $1000
CA46                    02039 	; 	'   com flip da ppu_ctrl ($B8) so durante a luta (sprites 8x16 leem a
CA46                    02040 	; 	'   tabela pelo bit0 do byte OAM: nada afetados). "Animacao" = PULSO
CA46                    02041 	; 	'   DE PALETA (ideia do autor: cor clara $38 cicla 38/28/18/28).
CA46                    02042 	; 	'   Balanco lateral classico de chefe-de-BG: SCROLL x fino +-16px
CA46                    02043 	; 	'   (ceu preto = wrap invisivel); tiros/laser/hitbox acompanham.
CA46                    02044 	; 	'   (b) BUG DOS TEXTOS da v0.12 explicado: PRINT escreve o codigo
CA46                    02045 	; 	'   ASCII DIRETO como tile - a FONTE mora nos tiles 32-95 da $0000,
CA46                    02046 	; 	'   exatamente onde a arte do boss tinha ido parar! (e caiu tambem o
CA46                    02047 	; 	'   tile 0 do $1000: ceu preto virou grade 2.0). Arte realocada p/
CA46                    02048 	; 	'   $1000 (257+, 272+, 436-511 = ex-asas); fonte 100% restaurada.
CA46                    02049 	; 	'   (c) duas armadilhas do codegen CVBasic mapeadas: byte var >=128
CA46                    02050 	; 	'   sign-extende ao ir p/ var 16-bit (#tbx 143 -> -113!), e somar o
CA46                    02051 	; 	'   byte-wrap 240 ("-16") em 16-bit vira +240. Resolvido com #bo.
CA46                    02052 	; 	' v0.12: fechamento da fase 01! (a) smalls: cota de MAX 3 tiros deles
CA46                    02053 	; 	'   na tela (tags ebt + contador nsm no eb_spawn/despawn). (b) mini-
CA46                    02054 	; 	'   boss agora para em y=72 e solta o LASER (arte do Saulo) que desce
CA46                    02055 	; 	'   rapido ao cruzar o meio exato (centro x=128: nasce e parqueia
CA46                    02056 	; 	'   em mbx=112). (c) BOSS 96x128 do
CA46                    02057 	; 	'   Saulo a cada 4 ondas-de-cada-tipo: hibrido BG (centro 48x128 +
CA46                    02058 	; 	'   strips, 102 tiles unicos $0000) + sprites (asas: 18 tiles $1000,
CA46                    02059 	; 	'   lado dir = flip H) - sprite puro era inviavel: 12 sprites por
CA46                    02060 	; 	'   scanline, limite do NES e 8! Fases: leques alternados das asas,
CA46                    02061 	; 	'   saraivada de posicoes/velocidades variadas, 3 lasers do meio;
CA46                    02062 	; 	'   tudo com trava no pool de 8 tiros. HP 120, +5000. Scroll congela
CA46                    02063 	; 	'   (boss e BG); pal BG1/pal2 ganham $03/$23/$38 e voltam na morte.
CA46                    02064 	; 	'   (d) tiro do player = nova arte do Saulo (fis 472/474, 217/219);
CA46                    02065 	; 	'   pal3 agora ciano ($1C/$3C/$30) p/ tiro+laser ficarem fi as artes.
CA46                    02066 	; 	' v0.12a (bug da grade): a arte BG do boss usava os tiles 32-95 do
CA46                    02067 	; 	'   banco $0000 - MAS o 32 ($20) e o byte que a CVBasic preenche a
CA46                    02068 	; 	'   nametable no boot (e o "espaco" do PRINT), e em branco na v0.11!
CA46                    02069 	; 	'   Todo o fundo "vazio" virou uma grade de pedacinhos do boss.
CA46                    02070 	; 	'   Forense: pixel-match do screenshot -> tile fis 32. Remapeada a
CA46                    02071 	; 	'   arte p/ 33-95 + 213-251 (gera_boss.py); o 32 voltou a ser vazio.
CA46                    02072 	; 	' v0.11: onda dos smalls (roxo) agora e 3+3: o 2o grupo entra logo
CA46                    02073 	; 	'   apos o 1o, no lado OPOSTO da tela (slots/OAM ampliados: smalls
CA46                    02074 	; 	'   0-5, sprites 4-15; por isso tiros->16-20, shards->21-24, tiros
CA46                    02075 	; 	'   inimigos->25-32, explosao->33/34, placar->35-39, vidas->40).
CA46                    02076 	; 	'   MINIBOSS NOVO (arte do Saulo, 32x32, 2 frames, tiles 396-427):
CA46                    02077 	; 	'   1 a cada 4 ondas; entra pelo topo, desce ate o meio e patrulha
CA46                    02078 	; 	'   esq/dir lancando aneis de 8 tiros (so dispara qdo o pool de
CA46                    02079 	; 	'   tiros inimigos esvazia = trava anti-slowdown); HP 48, +500 pts.
CA46                    02080 	; 	'   Usa os slots OAM 41-48 do enemy4 (nunca coexistem). Durante a
CA46                    02081 	; 	'   luta pal2 ganha as cores da arte ($03/$23/$38) e volta ao
CA46                    02082 	; 	'   normal ao morrer (chama da nave fica roxa nesse periodo).
CA46                    02083 	; 	' v0.10: estrelas de vez! Diagnostico definitivo (probe + medicao no
CA46                    02084 	; 	'   fceumm): o vizinho de scroll vertical da $2000 nesta ROM e a $2800
CA46                    02085 	; 	'   (a $2400 e ESPELHO da $2000 aqui). A v0.9 preencheu a $2400 (no-op)
CA46                    02086 	; 	'   e deixou a $2800 vazia = faixa sem estrelas cruzando a tela.
CA46                    02087 	; 	'   Solucao a prova de emulador: layout unico gravado nas TRES ($2000,
CA46                    02088 	; 	'   $2400 e $2800). Enemy4: atira ao cruzar a faixa topo-meio (y 64-
CA46                    02089 	; 	'   127) em vez de timer; onda com 8 naves a 0.5s (arrays/OAM 41-56);
CA46                    02090 	; 	'   colisao nave-inimigo DESTROI o inimigo (1 tiro de dano: small+100,
CA46                    02091 	; 	'   shard+120 c/ anel, enemy4+300).
CA46                    02092 	; 	' v0.9: fundo de estrelas com LOOP PERFEITO (a raiz do bug: a "NT2" era
CA46                    02093 	; 	'   escrita em $2800, que no espelhamento "vertical arrangement" da ROM
CA46                    02094 	; 	'   e ESPELHO da $2000; a vizinha real do wrap vertical e a $2400, que
CA46                    02095 	; 	'   nunca tinha sido preenchida!). Agora o layout e sorteado 1x no boot
CA46                    02096 	; 	'   e desenhado byte a byte igual nas 2 nametables ($2000/$2400).
CA46                    02097 	; 	'   Enemy4 (ex-"meteoro") mais rapido: e4v 10 -> 14 (+jitter por slot).
CA46                    02098 	; 	'   Pausa entre ondas 70 -> 30 frames (jogo mais desafiador).
CA46                    02099 	; 	' v0.8: ajustes no enemy4: sprite ESTATICO (economiza 12 tiles CHR),
CA46                    02100 	; 	'   agora ATIRA 1x (mirado, ~2.5s apos entrar), velocidade levemente
CA46                    02101 	; 	'   variada por slot, sprites movidos p/ 41-48 (33-39 eram o HUD de
CA46                    02102 	; 	'   sprites = placar/vidas, por isso "apagavam"!), e guarda ANTI-WRAP:
CA46                    02103 	; 	'   enemy4/shard/small escondidos enqto y<1 (nao nascem mais embaixo).
CA46                    02104 	; 	' v0.7: novo inimigo ENEMY4 (Enemy4.gif do autor): onda de 4 naves que
CA46                    02105 	; 	'   cruzam a tela do alto a base bem devagar (movimento de meteoro),
CA46                    02106 	; 	'   spawn 1.5s, cada uma numa das 4 colunas (32/88/144/200) embaralhadas
CA46                    02107 	; 	'   sem repeticao. Rodizio: small -> shard -> enemy4. 300 pts.
CA46                    02108 	; 	' v0.6: SPACE BLAST - novo nome + nova tela de titulo (logo 128x48 do
CA46                    02109 	; 	'   autor: SPACE branco, BLAST! ciano/teal, APERTE START branco piscando,
CA46                    02110 	; 	'   rodape ciano "2026 • FALCON SOFT"). Atributos da titulo reescritos a
CA46                    02111 	; 	'   cada entrada; begin_game zera a tabela de atributos (heranca visual).
CA46                    02112 	; 	' v0.5: TRILHAS SONORAS - arranjos NES das MP3 originais (titulo ~96bpm
CA46                    02113 	; 	'   G#m e fase 1 ~174bpm Gm) gerados por music/compose.py p/ o player do
CA46                    02114 	; 	'   CVBasic (PLAY FULL: pulso1=melodia, pulso2=arp, triangulo=baixo,
CA46                    02115 	; 	'   ruido=bateria). Titulo toca mus_title; jogo toca mus_stage1; game
CA46                    02116 	; 	'   over silencia. Performance medida: 99.7% do frame budget com musica.
CA46                    02117 	; 	'
CA46                    02118 	; 	' v0.2: corrige tiros inimigos (posicao nunca gravada p/ bug de codegen do
CA46                    02119 	; 	'   *16 em array 16-bit + mira com sinal quebrado), shard sumindo ao cruzar
CA46                    02120 	; 	'   x=128 (overflow 8-bit sinal na saida diagonal), 3 smalls/onda com frame
CA46                    02121 	; 	'   estatico, e divisoes /16 rapidas (posicoes com bias +256, sem _div16s).
CA46                    02122 	; 	' v0.1: inicio do game - ondas 01 (small formation) e 02 (shard formation)
CA46                    02123 	; 	' Direcional: move a nave. Botao B (segurar): rajada de 5 tiros.
CA46                    02124 	; 	' Start: inicia. Vidas: 3.
CA46                    02125 	; 	'
CA46                    02126 	; 	' Compilar:  cvbasic --nes space-blast.bas space-blast.asm
CA46                    02127 	; 	' Montar:    gasm80 space-blast.asm -o space-blast.nes
CA46                    02128 	; 	'
CA46                    02129 	; 
CA46                    02130 	; 	DIM st(64)		' tabela seno (zigzag dos smalls)
CA46                    02131 	; 	DIM boff,bdir,bpf	' BOSS: balanco lateral (+-16px), direcao, fase do pulso
CA46                    02132 	; 	DIM rr,q1,q2,q3,q4	' v0.14: rodizio OAM anti-flicker (Saulo) (k ja' existe: eb_spawn)
CA46                    02133 	; 	DIM diek			' v0.15: proc bancado pede morte da nave (GOTO externo proibido)
CA46                    02134 	; 	DIM r16(16)		' anel de slots fisicos (v0.14): smalls 0-11, shards 12-15
CA46                    02135 	; 	DIM shyc(4)		' v0.14: cache px do y dos shards (anel desenha todo frame)
CA46                    02136 	; 	DIM gbc			' contador do sky_clear (60 passos)
CA46                    02137 	; 	DIM #bk			' cursor de varredura do ceu preto (sky_clear)
CA46                    02138 	; 	DIM #bo			' boff com SINAL em 16 bits (p/ #tbx: byte >=128
CA46                    02139 	; 						' sign-extendia: asa dir. cuspia tiro em x=-113!)
CA46                    02140 	; 	DIM nep(23)		' tiles de estrela nao-vazios (sorteio harmonico)
CA46                    02141 	; 	DIM stt(48)		' layout de estrelas (gerado 1x no boot): tile por setor
CA46                    02142 	; 	DIM #stw(48)		' layout de estrelas: offset do setor na nametable (0-959)
CA46                    02143 	; 	DIM fase,bsc,ph,sy,srq,wr,wrf,ring(32)	' v0.23: fase atual, anel lava=linha-
CA46                    02144 	; 							'   mundo da costura + trava de fase, contador cerimonia
CA46                    02145 	; 	DIM r,q,e2		' scratch do fundo de estrelas / mapa da logo
CA46                    02146 	; 	DIM sk			' indice do layout de estrelas
CA46                    02147 	; 	DIM btx(5)		' tiros do player: x
CA46                    02148 	; 	DIM bty(5)		' tiros do player: y (0 = livre)
CA46                    02149 	; 	DIM sma(6)		' smalls: ativo? (v0.11: 6 slots p/ onda 3+3)
CA46                    02150 	; 	DIM smx(6)		' smalls: x
CA46                    02151 	; 	DIM #smy(6)		' smalls: (y+256)*16 (sempre positivo = /16 rapida!)
CA46                    02152 	; 	DIM smz(6)		' smalls: fase do zigzag (0-63)
CA46                    02153 	; 	DIM smp(6)		' smalls: x central do zigzag
CA46                    02154 	; 	DIM smc(6)		' smalls: amplitude do zigzag
CA46                    02155 	; 	DIM smd(6)		' smalls: timer do tiro
CA46                    02156 	; 	DIM smf(6)		' smalls: tiros dados
CA46                    02157 	; 	DIM snv(6)		' smalls: velocidade y (1/16 px/frame)
CA46                    02158 	; 	DIM smyy(6)		' v0.14: cache do y em pixel (anel desenha todo frame)
CA46                    02159 	; 	DIM sha(4)		' shards: ativo?
CA46                    02160 	; 	DIM shx(4)		' shards: x
CA46                    02161 	; 	DIM #shy(4)		' shards: (y+256)*16 (sempre positivo)
CA46                    02162 	; 	DIM shf(4)		' shards: fase (0 desce, 1 sai na diagonal)
CA46                    02163 	; 	DIM shvx(4)		' shards: vx da saida (+2/-2)
CA46                    02164 	; 	DIM e4a(8)		' enemy4: ativo?
CA46                    02165 	; 	DIM e4x(8)		' enemy4: x
CA46                    02166 	; 	DIM #e4y(8)		' enemy4: (y+256)*16
CA46                    02167 	; 	DIM e4p(8)		' enemy4: colunas embaralhadas (2 permutacoes de 4)
CA46                    02168 	; 	DIM e4v			' enemy4: velocidade base de descida (1/16 px/frame)
CA46                    02169 	; 	DIM e4w(8)		' enemy4: velocidade individual (base + jitter)
CA46                    02170 	; 	DIM e4f(8)		' enemy4: 1 = ainda nao atirou (atira ao cruzar y=64)
CA46                    02171 	; 	DIM eba(8)		' tiros inimigos: ativo?
CA46                    02172 	; 	DIM ebt(8)		' tiros inimigos: dono (1 = small) - cota v0.12
CA46                    02173 	; 	DIM #ebx(8)		' tiros inimigos: (x+256)*16
CA46                    02174 	; 	DIM #eby(8)		' tiros inimigos: (y+256)*16
CA46                    02175 	; 	DIM ebxv(8)		' tiros inimigos: vx (1/16)
CA46                    02176 	; 	DIM ebyv(8)		' tiros inimigos: vy (1/16)
CA46                    02177 	; 	DIM xb,yc		' scratch de pixel p/ sprites
CA46                    02178 	; 	DIM k			' indice do eb_spawn (nao pode usar c!)
CA46                    02179 	; 	DIM #c1,#c2		' scratch assinado p/ colisoes
CA46                    02180 	; 	DIM #t1,#t2		' pixel biased dos tiros inimigos (div reuse)
CA46                    02181 	; 	DIM s0,s1,s2,s3,s4	' placar em digitos (10000..1), sem divisoes!
CA46                    02182 	; 
