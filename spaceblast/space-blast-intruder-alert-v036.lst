819C                    00813 ; FAMISTUDIO_UPDATE_CHANNEL_SOUND (internal)
819C                    00814 ;
819C                    00815 ; Uber-macro used to update the APU registers for a given 2A03/VRC6/MMC5 channel. This macro is an absolute mess, but
819C                    00816 ; it is still more maintainable than having many different functions.
819C                    00817 ;
819C                    00818 ; [in] no input params.
819C                    00819 ;======================================================================================================================
819C                    00820 
819C                    00821 
819C                    00822 
819C                    00823 
819C                    00824 
819C                    00825 
819C                    00826 
819C                    00827 
819C                    00828 
819C                    00829 
819C                    00830 ;======================================================================================================================
819C                    00831 ; FAMISTUDIO_UPDATE (public)
819C                    00832 ;
819C                    00833 ; Main update function, should be called once per frame, ideally at the end of NMI. Will update the tempo, advance
819C                    00834 ; the song if needed, update instrument and apply any change to the APU registers.
819C                    00835 ;
819C                    00836 ; [in] no input params.
819C                    00837 ;======================================================================================================================
819C                    00838 
819C                    00839 FAMISTUDIO_UPDATE:
819C                    00840 
819C                    00841 .PITCH_ENV_TYPE: EQU FAMISTUDIO_R0
819C                    00842 .TEMP_PITCH: EQU FAMISTUDIO_R1
819C                    00843 .TEMPO_ENV_PTR: EQU FAMISTUDIO_PTR0
819C                    00844 .ENV_PTR: EQU FAMISTUDIO_PTR0
819C                    00845 .PITCH_ENV_PTR: EQU FAMISTUDIO_PTR0
819C                    00846 
819C                    00847 
819C  AD9405            00848     LDA FAMISTUDIO_SONG_SPEED ; Speed 0 means that no music is playing currently
819F  3002              00849     BMI .PAUSE ; Bit 7 set is the pause flag
81A1  D008              00850     BNE .UPDATE
81A3                    00851 .PAUSE:
81A3  A901              00852     LDA #1
81A5  8D8905            00853     STA FAMISTUDIO_TEMPO_FRAME_CNT
81A8  4CD482            00854     JMP .UPDATE_SOUND
81AB                    00855 
81AB                    00856 ;----------------------------------------------------------------------------------------------------------------------
81AB                    00857 .UPDATE:
81AB                    00858 
81AB                    00859 
81AB                    00860     ; Decrement envelope counter, see if we need to advance.
81AB  CE8605            00861     DEC FAMISTUDIO_TEMPO_ENV_COUNTER
81AE  F005              00862     BEQ .ADVANCE_TEMPO_ENVELOPE
81B0  A901              00863     LDA #1
81B2  4CDB81            00864     JMP .STORE_FRAME_COUNT
81B5                    00865 
81B5                    00866 .ADVANCE_TEMPO_ENVELOPE:
81B5                    00867     ; Advance the envelope by one step.
81B5  AD8405            00868     LDA FAMISTUDIO_TEMPO_ENV_PTR_LO
81B8  8506              00869     STA .TEMPO_ENV_PTR+0
81BA  AD8505            00870     LDA FAMISTUDIO_TEMPO_ENV_PTR_HI
81BD  8507              00871     STA .TEMPO_ENV_PTR+1
81BF                    00872 
81BF  EE8705            00873     INC FAMISTUDIO_TEMPO_ENV_IDX
81C2  AC8705            00874     LDY FAMISTUDIO_TEMPO_ENV_IDX
81C5  B106              00875     LDA (.TEMPO_ENV_PTR),Y
81C7  1007              00876     BPL .STORE_COUNTER ; Negative value means we loop back to to index 1.
81C9                    00877 
81C9                    00878 .TEMPO_ENVELOPE_END:
81C9  A001              00879     LDY #1
81CB  8C8705            00880     STY FAMISTUDIO_TEMPO_ENV_IDX
81CE  B106              00881     LDA (.TEMPO_ENV_PTR),Y
81D0                    00882 
81D0                    00883 .STORE_COUNTER:
81D0                    00884     ; Reset the counter
81D0  8D8605            00885     STA FAMISTUDIO_TEMPO_ENV_COUNTER
81D3  AD8805            00886     LDA FAMISTUDIO_TEMPO_FRAME_NUM
81D6  D003              00887     BNE .STORE_FRAME_COUNT
81D8  4CAA83            00888     JMP .SKIP_FRAME
81DB                    00889 
81DB                    00890 .STORE_FRAME_COUNT:
81DB  8D8905            00891     STA FAMISTUDIO_TEMPO_FRAME_CNT
81DE                    00892 
81DE                    00893 
81DE                    00894 ;----------------------------------------------------------------------------------------------------------------------
81DE                    00895 .ADVANCE_SONG:
81DE  A200              00896     LDX #0
81E0                    00897     .CHANNEL_LOOP:
81E0  E004              00898             CPX #4
81E2  F003              00899             BEQ .CHANNEL_LOOP_END
81E4  206384            00900             JSR FAMISTUDIO_ADVANCE_CHANNEL
81E7                    00901         .CHANNEL_LOOP_END:
81E7  E8                00902         INX
