B3B8  38                20664 	SEC
B3B9  E502              20665 	SBC TEMP
B3BB  AA                20666 	TAX
B3BC  98                20667 	TYA
B3BD  E503              20668 	SBC TEMP+1
B3BF  A8                20669 	TAY
B3C0  8A                20670 	TXA
B3C1  8583              20671 	STA CVB_SLOT
B3C3                    20672 	; 		END IF
B3C3                    20673 CV535:
