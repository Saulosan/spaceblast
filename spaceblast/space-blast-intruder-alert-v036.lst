B377                    20605 	; 	' v0.28: desvira + idle da nave. Saiu do banco 0 (estourou 97 bytes
B377                    20606 	; 	' com as 5 fases + fim de jogo); mesmo padrao do mb_frame/boss_frame
B377                    20607 	; 	' (proc quente chamado do game_loop com BANK SELECT 1/0).
B377                    20608 	; 	'
B377                    20609 	; anim_idle:	PROCEDURE	' soltou o direcional: desvira (6,5,4) e faz idle
B377                    20610 CVB_ANIM_IDLE:
B377                    20611 	; 	IF ret = 0 THEN
B377  A5B2              20612 	LDA CVB_RET
B379  D00C              20613 	BNE.L CV531
B37B                    20614 	; 		IF dir <> 0 THEN
B37B  A577              20615 	LDA CVB_DIR
B37D  F008              20616 	BEQ.L CV532
B37F                    20617 	; 			ret = 1
B37F  A901              20618 	LDA #1
B381  85B2              20619 	STA CVB_RET
B383                    20620 	; 			an = 0
B383  A900              20621 	LDA #0
B385  85A6              20622 	STA CVB_AN
B387                    20623 	; 		END IF
B387                    20624 CV532:
B387                    20625 	; 	END IF
B387                    20626 CV531:
B387                    20627 	; 	IF ret <> 0 THEN
B387  A5B2              20628 	LDA CVB_RET
B389  F03B              20629 	BEQ.L CV533
B38B                    20630 	; 		an = an + 1
B38B  E6A6              20631 	INC CVB_AN
B38D                    20632 	; 		IF an >= 12 THEN
B38D  A5A6              20633 	LDA CVB_AN
B38F  C90C              20634 	CMP #12
B391  900B              20635 	BCC.L CV534
B393                    20636 	; 			ret = 0
B393  A900              20637 	LDA #0
B395  85B2              20638 	STA CVB_RET
B397                    20639 	; 			dir = 0
B397  8577              20640 	STA CVB_DIR
B399                    20641 	; 			an = 0
B399  85A6              20642 	STA CVB_AN
