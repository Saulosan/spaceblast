8000                    00140 FAMISTUDIO_DPCM_PTR: EQU (FAMISTUDIO_DPCM_OFF & $3FFF) >> 6
8000                    00141 
8000                    00142 FAMISTUDIO_NUM_ENVELOPES: EQU 3+3+2+3
8000                    00143 FAMISTUDIO_NUM_PITCH_ENVELOPES: EQU 3
8000                    00144 FAMISTUDIO_NUM_CHANNELS: EQU 5
8000                    00145 FAMISTUDIO_NUM_DUTY_CYCLES: EQU 3
8000                    00146 
8000                    00147 FAMISTUDIO_NUM_VOLUME_SLIDES: EQU 4
8000                    00148 
8000                    00149 FAMISTUDIO_NUM_SLIDES: EQU FAMISTUDIO_NUM_PITCH_ENVELOPES
8000                    00150 
8000                    00151 ; Keep the noise slide at the end so the pitch envelopes/slides are in sync.
8000                    00152 FAMISTUDIO_NOISE_SLIDE_INDEX: EQU FAMISTUDIO_NUM_SLIDES - 1
8000                    00153 
8000                    00154 
8000                    00155 ; TODO: Investigate reshuffling the envelopes to keep them contiguously 
8000                    00156 ; by type (all volumes envelopes, all arp envelopes, etc.) instead of 
8000                    00157 ; by channel. This *may* simplify a lot of places where we need a lookup
8000                    00158 ; table (famistudio_channel_to_volume_env, etc.)
8000                    00159 FAMISTUDIO_CH0_ENVS: EQU 0
8000                    00160 FAMISTUDIO_CH1_ENVS: EQU 3
